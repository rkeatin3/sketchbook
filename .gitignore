# Bazel
/bazel-*
/user.bazelrc

# Datasets — large, fetched on demand, never committed.
/data/*
!/data/.gitkeep
!/data/README.md

# Build / editor detritus
compile_commands.json
.cache/
*.o
*.a
*.so
*.dylib

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.coverage
.coverage.*
coverage.xml
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Wiki build output
docs/_build/

# OS / IDE
.DS_Store
.idea/
*.swp

# VS Code — settings/tasks/extensions are checked in for a consistent editor
# setup; ignore everything else (e.g. per-user overrides, extension state).
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/README.md
