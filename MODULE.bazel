"""sketchbook — bzlmod module definition.

Versions are pinned against the Bazel Central Registry
(https://registry.bazel.build) and bumped deliberately.
"""

module(
    name = "sketchbook",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.2.19")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")
bazel_dep(name = "eigen", version = "5.0.1.bcr.2")

# compile_commands.json generation for clangd and clang-tidy (dev-only).
# hedron's refresh rule uses py_binary, which needs rules_python in the dep
# graph. hedron isn't on the BCR, so it is pinned to a commit.
bazel_dep(name = "rules_python", version = "1.9.1", dev_dependency = True)
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
    commit = "abb61a688167623088f8768cc9264798df6a9d10",
)
