{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Bazel: Refresh compile_commands.json",
      "type": "shell",
      "command": "bazel run //tools:refresh_compile_commands",
      "problemMatcher": [],
      "presentation": { "reveal": "silent" },
      "detail": "Regenerates the compilation database clangd uses for IntelliSense. Run after adding/changing BUILD.bazel targets."
    },
    {
      "label": "Bazel: Build all",
      "type": "shell",
      "command": "bazel build //...",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Bazel: Test all",
      "type": "shell",
      "command": "bazel test //...",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Bazel: Test current package",
      "type": "shell",
      "command": "bazel test //${relativeFileDirname}:all",
      "group": "test",
      "problemMatcher": ["$gcc"],
      "detail": "Runs every test target in the package of the file open in the editor."
    },
    {
      "label": "Bazel: Test current package (filtered)",
      "type": "shell",
      "command": "bazel test //${relativeFileDirname}:all --test_filter='${input:testFilter}' --test_output=all",
      "group": "test",
      "problemMatcher": ["$gcc"],
      "detail": "Runs only the googletest cases matching a filter, e.g. GaussianPdf.* or *Fit*."
    },
    {
      "label": "Pre-commit: run all",
      "type": "shell",
      "command": "pre-commit run --all-files",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "testFilter",
      "type": "promptString",
      "description": "googletest filter (Suite.Test, wildcards allowed)",
      "default": "*"
    }
  ]
}
