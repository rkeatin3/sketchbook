# ---------------------------------------------------------------------------
# Language standard — C++23 everywhere, no exceptions.
# ---------------------------------------------------------------------------
build --cxxopt=-std=c++23
build --host_cxxopt=-std=c++23

# hedron_compile_commands uses the native py_*/cc_binary symbols; autoload
# just those. Our own targets load rules explicitly.
common --incompatible_autoload_externally=+py_binary,+py_library,+py_test,+cc_binary

# ---------------------------------------------------------------------------
# Warnings — treat the compiler as a first reviewer.
# ---------------------------------------------------------------------------
build --cxxopt=-Wall
build --cxxopt=-Wextra
build --cxxopt=-Wpedantic
build --cxxopt=-Wshadow
build --cxxopt=-Wconversion
build --cxxopt=-Wnon-virtual-dtor

# ---------------------------------------------------------------------------
# Test output
# ---------------------------------------------------------------------------
test --test_output=errors
test --test_summary=detailed

# ---------------------------------------------------------------------------
# Named configurations
# ---------------------------------------------------------------------------
build:opt   --compilation_mode=opt
build:dbg   --compilation_mode=dbg

build:asan  --features=asan
build:asan  --copt=-fno-omit-frame-pointer

build:ubsan --features=ubsan

build:tsan  --features=tsan
build:tsan  --copt=-fno-omit-frame-pointer

build:strict --cxxopt=-Werror

# Local developer overrides, gitignored.
try-import %workspace%/user.bazelrc
