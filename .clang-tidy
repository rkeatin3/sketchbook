---
# Checks are deliberately strict. This repo is a study environment; the linter
# is a tutor, not a gate. Disable individual checks with a comment explaining
# why rather than silently loosening this file.
#
# Comments can't go inside the folded list below, so the reasons are here:
# - bugprone-throwing-static-initialization, cppcoreguidelines-owning-memory:
#   fire on every googletest TEST macro expansion, not on code in this repo.
#   The first is new in LLVM 22 (renamed from cert-err58-cpp, which isn't
#   enabled here), so it matters for local runs; older clang-tidy, like CI's,
#   ignores the unknown name.
# - bugprone-random-generator-seed: constant seeds are deliberate; every
#   random run must be replayable.
Checks: >
  -*,
  bugprone-*,
  cppcoreguidelines-*,
  modernize-*,
  performance-*,
  readability-*,
  misc-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-magic-numbers,
  -readability-identifier-length,
  -modernize-use-trailing-return-type,
  -misc-non-private-member-variables-in-classes,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -bugprone-throwing-static-initialization,
  -cppcoreguidelines-owning-memory,
  -bugprone-random-generator-seed

WarningsAsErrors: ''
HeaderFilterRegex: '^src/|^papers/'
FormatStyle: file

CheckOptions:
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: CamelCase
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: '_'
  - key: readability-identifier-naming.ConstexprVariablePrefix
    value: 'k'
